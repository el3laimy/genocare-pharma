<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GenoCare.Infrastructure</AssemblyName>
    <RootNamespace>GenoCare.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GenoCare.Application\GenoCare.Application.csproj" />
    <ProjectReference Include="..\GenoCare.Domain\GenoCare.Domain.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- Explicitly pin the SQLite native bundle past the advisory pulled by older EF packages. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
