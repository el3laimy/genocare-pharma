<Window
    x:Class="GenoCare.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="GenoCare">
    <Grid FlowDirection="RightToLeft">
        <muxc:NavigationView x:Name="NavigationShell" IsBackButtonVisible="Collapsed" Loaded="NavigationShell_Loaded" SelectionChanged="NavigationShell_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="الأصناف" Tag="Products" />
                <muxc:NavigationViewItem Content="التشغيلات والمخزون" Tag="Batches" />
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
        <Border x:Name="StartupErrorPanel" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Visibility="Collapsed" Padding="32">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="جينوكير" FontSize="28" />
                <TextBlock x:Name="StartupErrorText" TextWrapping="Wrap" MaxWidth="700" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
